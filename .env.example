# Copy to .env.local (or .env.server) and fill in what you use.
# Everything is optional — the app runs fully local with no keys at all.

# --- Text generation defaults ---
# local = Ollama, custom = "Connect a server" / OpenAI-compatible.
# Unset = the built-in default: custom, llama.cpp on http://127.0.0.1:8001/v1
# serving qwen3.6-35b. Uncomment to override, e.g. to run on Ollama instead.
#DEFAULT_TEXT_PROVIDER=local
#LOCAL_TEXT_MODEL=gemma4:31b-it-qat

# --- Text generation: "Connect a server" provider (all optional) ---
# The Mac launchers can fill these in, or you can enter URL/model in-app.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
# For OpenRouter URLs:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash
# For any other OpenAI-compatible server that needs a key:
OPENAI_COMPAT_API_KEY=
# Max output tokens per remote turn, plus OpenRouter attribution headers:
OPENROUTER_MAX_TOKENS=16384
OPENROUTER_APP_TITLE=Open Dungeon
OPENROUTER_APP_URL=http://localhost:3000

# --- Text generation: local via Ollama (the legacy "local" provider) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_TEXT_MAX_TOKENS=4096
# Context window for local turns. Unset = the model's full native window
# (128K-256K). Set a lower cap to bound prefill time on very long stories.
LOCAL_TEXT_CONTEXT=

# --- Image generation via the OpenAI API (optional, no GPU needed) ---
# Pick "openai" as the image backend (admin panel or the var below) and set
# a key; renders bill to that key. Model blank = gpt-image-1. The base URL
# is only for OpenAI-compatible image proxies.
#DEFAULT_IMAGE_BACKEND=openai
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_BASE_URL=

# --- Image generation (optional, needs ultra-fast-image-gen) ---
FLUX_WORKER_URL=http://127.0.0.1:7869
ULTRA_FAST_IMAGE_GEN_DIR=~/ultra-fast-image-gen
# macOS/Linux: ~/ultra-fast-image-gen/.venv/bin/python
# Windows: %USERPROFILE%\ultra-fast-image-gen\.venv\Scripts\python.exe
ULTRA_FAST_IMAGE_GEN_PYTHON=
IMAGE_SERVER_DEVICE=auto
IMAGE_SERVER_DEFAULT_BACKEND=
# Patched MFLUX checkout (made by ultra-fast-image-gen/scripts/setup_mflux_hs.sh).
# Defaults to ~/.cache/ultra-fast-image-gen/mflux — usually leave unset.
MFLUX_DIR=

# --- Storage ---
SQLITE_DB_PATH=

# --- Live voice chat (optional, off by default) ---
# Set VOICE_ENABLED=1 to turn it on. It stays off unless you do, because it
# cannot work until you also open the port below and serve the app over https.
VOICE_ENABLED=0
# Voice needs ONE extra port beyond the web port, open for both UDP and TCP.
# It carries the audio itself (RTP over DTLS-SRTP), which is not HTTP and so
# cannot go through a reverse proxy: open it on the firewall pointing straight
# at this host. UDP is the real path; TCP on the same number is the fallback
# for networks that block outbound UDP.
VOICE_RTC_PORT=44444
# The address a PLAYER'S BROWSER can reach this host on. Normally your public
# IP (or LAN IP for a LAN-only game). Leave empty for a localhost-only install.
# Unset behind NAT or in Docker is the classic "connects, then silence".
VOICE_ANNOUNCED_IP=
# Optional: announce a hostname instead of the raw IP. Wins over
# VOICE_ANNOUNCED_IP when set; leave empty and the IP is used.
# It must resolve straight to this host: a Cloudflare-proxied (orange cloud)
# name resolves to Cloudflare, which does not carry UDP, so the call connects
# and stays silent. Use a DNS-only (grey cloud) record.
VOICE_DOMAIN=
# Which local interface to bind. 0.0.0.0 (all) is almost always right; this is
# the bind address, NOT the announced one.
VOICE_LISTEN_IP=0.0.0.0

# Mesh voice fetches STUN/TURN servers from this broker (the project's
# Cloudflare Worker by default). Point it at your own deployment of
# workers/tunnel-broker, or set it to "off" to skip the call entirely and
# run on public STUN alone (most tables still connect; peers behind strict
# NATs may not).
ODM_ICE_BROKER_URL=

# NOTE: microphone access requires a secure context. Browsers block getUserMedia
# on plain http except on localhost, so voice chat (and push-to-talk speech to
# text) need the app reached over https, normally via a reverse proxy.

# --- Dev server access from other devices (e.g. phone over Tailscale) ---
# Comma-separated extra hostnames/IPs allowed to reach `next dev`.
ALLOWED_DEV_ORIGINS=
