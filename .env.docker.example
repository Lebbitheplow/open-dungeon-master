# Copy to .env next to docker-compose.yml. Every line is optional: the compose
# file already carries working defaults, and a missing DB_ENCRYPTION_KEY is
# generated into the data volume on first boot.
#
#   cp .env.docker.example .env

# Host port the app is published on.
#ODM_PORT=3005

# Which published image to run. Docker Hub by default; uncomment for GHCR.
#ODM_IMAGE=ghcr.io/lebbitheplow/open-dungeon-master

# Pin a published release instead of tracking :latest.
#ODM_IMAGE_TAG=0.10.1

# Database encryption key. Generate with: openssl rand -hex 32
# Set it here if you would rather manage the key yourself than let the container
# store one in the data volume. Losing this key destroys the database.
#DB_ENCRYPTION_KEY=

# --- Text backend -----------------------------------------------------------
# llama.cpp (or any OpenAI-compatible server) running on the host.
#OPENAI_COMPAT_BASE_URL=http://host.docker.internal:8001/v1
#OPENAI_COMPAT_MODEL=qwen3.6-35b
#OPENAI_COMPAT_API_KEY=

# Or Ollama on the host.
#DEFAULT_TEXT_PROVIDER=local
#OLLAMA_BASE_URL=http://host.docker.internal:11434

# Or a hosted model.
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=google/gemini-3.5-flash

# --- Images and speech ------------------------------------------------------
#COMFYUI_URL=http://host.docker.internal:8188
#KOKORO_URL=http://host.docker.internal:8880
#STT_URL=http://host.docker.internal:8870

# --- Behind a reverse proxy -------------------------------------------------
#APP_PUBLIC_URL=https://dnd.example.com
#COOKIE_SECURE=1

# --- Discord sign-in (optional) ---------------------------------------------
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=

# --- Debugging --------------------------------------------------------------
#DM_DEBUG=1

# --- Live voice chat (optional, off by default) ------------------------------
# Set to 1 to turn it on. Needs ONE extra port beyond the web port, published
# for UDP and TCP by docker-compose.yml. The audio is not HTTP and does not
# pass through a reverse proxy, so open this port on the firewall pointing at
# this host.
VOICE_ENABLED=0
VOICE_RTC_PORT=44444
# REQUIRED under Docker: the address a player's browser can reach this host
# on, normally your public IP. Left empty the container announces its own
# 172.x bridge address, calls negotiate, and then stay silent.
VOICE_ANNOUNCED_IP=
# Optional hostname to announce instead of the IP. Must resolve straight to
# this host: a Cloudflare-proxied (orange cloud) name resolves to Cloudflare,
# which does not carry UDP. Use a DNS-only (grey cloud) record.
VOICE_DOMAIN=

# Browsers only allow microphone access over https (or on localhost), so voice
# chat also needs the reverse proxy and APP_PUBLIC_URL set above.
